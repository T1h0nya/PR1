<Window x:Class="PR_22_09.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR_22_09"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TabControl>
            <!-- Вкладка для обоев -->
            <TabItem Header="Обои">
                <StackPanel Margin="10">
                    <TextBlock Text="Расчет обоев" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Ширина комнаты (м):" Grid.Row="0" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="txtRoomWidth" Grid.Row="0" Grid.Column="1" Margin="5" />

                        <TextBlock Text="Длина комнаты (м):" Grid.Row="1" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="txtRoomLength" Grid.Row="1" Grid.Column="1" Margin="5" />

                        <TextBlock Text="Высота комнаты (м):" Grid.Row="2" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="txtRoomHeight" Grid.Row="2" Grid.Column="1" Margin="5" />

                        <TextBlock Text="Высота окна (м):" Grid.Row="3" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="txtWindowHeight" Grid.Row="3" Grid.Column="1" Margin="5" />

                        <TextBlock Text="Ширина окна (м):" Grid.Row="4" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="txtWindowWidth" Grid.Row="4" Grid.Column="1" Margin="5" />

                        <TextBlock Text="Высота двери (м):" Grid.Row="5" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="txtDoorHeight" Grid.Row="5" Grid.Column="1" Margin="5" />

                        <TextBlock Text="Ширина двери (м):" Grid.Row="6" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="txtDoorWidth" Grid.Row="6" Grid.Column="1" Margin="5" />
                       
                        <TextBlock Text="Ширина рулона:" Grid.Row="7" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="cmbRollWidth" Grid.Row="7" Grid.Column="1" Margin="5" />
                    </Grid>

                    <Button x:Name="btnCalculateWallpaper" Content="Рассчитать" 
                    Click="CalculateWallpaper_Click" Margin="5" Padding="10,5"/>

                    <TextBlock x:Name="lblWallpaperResult" FontSize="14" FontWeight="Bold" 
                      Margin="5" Foreground="Blue"/>
                </StackPanel>
            </TabItem>

            <!-- Вкладка для линолеума -->
            <TabItem Header="Линолеум">
                <StackPanel Margin="10">
                    <TextBlock Text="Расчет линолеума" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Ширина комнаты (м):" Grid.Row="0" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="txtLinRoomWidth" Grid.Row="0" Grid.Column="1" Margin="5" />

                        <TextBlock Text="Длина комнаты (м):" Grid.Row="1" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="txtLinRoomLength" Grid.Row="1" Grid.Column="1" Margin="5" />

                        <TextBlock Text="Ширина линолеума:" Grid.Row="2" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="cmbLinoleumWidth" Grid.Row="2" Grid.Column="1" Margin="5"/>

                    </Grid>

                    <Button x:Name="btnCalculateLinoleum" Content="Рассчитать" 
                    Click="CalculateLinoleum_Click" Margin="5" Padding="10,5"/>
                    <TextBlock x:Name="lblLinoleumResult" FontSize="14" FontWeight="Bold" 
                      Margin="5" Foreground="Blue"/>
                </StackPanel>
            </TabItem>

            <!-- Вкладка для краски -->
            <TabItem Header="Краска">
                <StackPanel Margin="10">
                    <TextBlock Text="Расчет краски для потолка" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Ширина комнаты (м):" Grid.Row="0" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="txtPaintRoomWidth" Grid.Row="0" Grid.Column="1" Margin="5" Text="4"/>

                        <TextBlock Text="Длина комнаты (м):" Grid.Row="1" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="txtPaintRoomLength" Grid.Row="1" Grid.Column="1" Margin="5" Text="5"/>

                        <TextBlock Text="Расход краски (л/м²):" Grid.Row="2" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="txtPaintConsumption" Grid.Row="2" Grid.Column="1" Margin="5" Text="0.15"/>

                        <TextBlock Text="Объем банки (л):" Grid.Row="3" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="txtCanVolume" Grid.Row="3" Grid.Column="1" Margin="5" Text="2.5"/>
                    </Grid>

                    <Button x:Name="btnCalculatePaint" Content="Рассчитать" 
                    Click="CalculatePaint_Click" Margin="5" Padding="10,5"/>

                    <TextBlock x:Name="lblPaintResult" FontSize="14" FontWeight="Bold" 
                      Margin="5" Foreground="Blue"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
